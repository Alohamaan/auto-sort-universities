APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data.db

GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_MONITORED_LABEL=INBOX
GMAIL_SEARCH_QUERY=newer_than:14d -category:promotions -category:social
GMAIL_REVIEW_LABEL_NAME=admissions/review-queue
GMAIL_PENDING_LABEL_NAME=admissions/pending-action

GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEETS_WORKSHEET_NAME=Admissions
GOOGLE_SHEETS_APPLICATIONS_WORKSHEET_NAME=Applications
GOOGLE_SHEETS_RULES_WORKSHEET_NAME=EmailRules
GOOGLE_SHEETS_REVIEW_QUEUE_WORKSHEET_NAME=ReviewQueue
GOOGLE_SHEETS_AGENT_LOG_WORKSHEET_NAME=AgentLog
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/app/secrets/service-account.json

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
WEBHOOK_BASE_URL=https://example.ngrok.app
